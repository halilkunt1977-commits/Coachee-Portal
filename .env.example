# PostgreSQL des Portals (eigene Datenbank in Coolify, nicht die von gründarium.de)
DATABASE_URL=postgres://portal:passwort@portal-db:5432/portal
# Zufälliger Schlüssel, mindestens 32 Zeichen: openssl rand -hex 32
# Verschlüsselt Zwei-Faktor-Schlüssel und Dateien. Nie ändern, sonst sind diese Daten nicht mehr lesbar.
APP_SECRET=
# Öffentliche Adresse des Portals, für Links in E-Mails
PORTAL_URL=https://portal.gruendarium.de
# E-Mail-Versand (Strato)
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=info@gruendarium.de
SMTP_PASS=
MAIL_FROM=Gründarium Portal <info@gruendarium.de>
# KI (OpenAI), optional
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# KI-Aufrufe pro Coachee und Monat (Lebenslauf-Hilfe usw.), der Coach ist nicht begrenzt
# AI_COACHEE_MONTHLY_LIMIT=40
# Chromium für PDF-Export (im Docker-Image schon gesetzt)
# CHROMIUM_PATH=/usr/bin/chromium
# Anwesenheit: Erfolgspfad-Mails aus diesem Postfach lesen (nur lesend), optional
IMAP_USER=kunt@kuntsolutions.de
IMAP_PASS=
# IMAP_HOST=imap.strato.de
# IMAP_PORT=993
# Absender für den Posteingang (Teil der Adresse oder des Namens)
# INBOX_FROM=erfolgspfad,avocons,avgs-coaching,regus

# Teams und Outlook (optional): App-Registrierung in Microsoft Entra mit Anwendungsberechtigung Calendars.ReadWrite
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_CALENDAR_USER=

# Datensicherung (siehe docs/datensicherung.md). Schlüssel: openssl rand -hex 32, zusätzlich im Passwort-Manager ablegen.
# Ohne BACKUP_KEY wird aus APP_SECRET abgeleitet.
BACKUP_KEY=
# Kopie außer Haus in einen S3-Speicher (z. B. Hetzner Object Storage, Backblaze B2, IONOS S3), optional
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_PREFIX=portal-sicherung/
# BACKUP_TIME=02:30
# BACKUP_DIR=/app/data/backups
