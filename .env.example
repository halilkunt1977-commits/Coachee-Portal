# PostgreSQL des Portals (eigene Datenbank in Coolify, nicht die von gründarium.de)
DATABASE_URL=postgres://portal:passwort@portal-db:5432/portal
# Zufälliger Schlüssel, mindestens 32 Zeichen: openssl rand -hex 32
# Verschlüsselt Zwei-Faktor-Schlüssel und Dateien. Nie ändern, sonst sind diese Daten nicht mehr lesbar.
APP_SECRET=
# Öffentliche Adresse des Portals, für Links in E-Mails
PORTAL_URL=https://portal.gründarium.de
# E-Mail-Versand (Strato)
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=info@gruendarium.de
SMTP_PASS=
MAIL_FROM=Gründarium Portal <info@gruendarium.de>
# KI (OpenAI), optional
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# KI-Aufrufe pro Coachee und Monat (Lebenslauf-Hilfe usw.), der Coach ist nicht begrenzt
# AI_COACHEE_MONTHLY_LIMIT=40
# Chromium für PDF-Export (im Docker-Image schon gesetzt)
# CHROMIUM_PATH=/usr/bin/chromium
